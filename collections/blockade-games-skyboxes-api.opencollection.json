        {
          "info": {
            "name": "Get Skybox Styles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://backend.blockadelabs.com/api/v1/skybox/styles",
            "headers": [
              {
                "name": "x-api-key",
                "value": "{YOUR_API_KEY}"
              }
            ],
            "params": [
              {
                "name": "model_version",
                "value": "",
                "type": "query",
                "description": "Filter skybox styles by model version number (ie. \"2\" or \"3\")"
              }
            ]
          },
          "docs": "Returns the list of predefined styles that can influence the overall aesthetic of your skybox generation."
        },
        {
          "info": {
            "name": "Get Skybox Style Families",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://backend.blockadelabs.com/api/v1/skybox/families",
            "headers": [
              {
                "name": "x-api-key",
                "value": "{YOUR_API_KEY}"
              }
            ]
          },
          "docs": "Returns the list of predefined styles that can influence the overall aesthetic of your skybox generation, sorted by style family. This route can be used in order to build a menu of styles sorted by family."
        },
        {
          "info": {
            "name": "Get Skybox by id",
